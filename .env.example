# =============================================================================
# NEON DATABASE CONFIGURATION
# =============================================================================
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# =============================================================================
# AUTH NATIVO (Neon — sem Supabase Auth)
# =============================================================================
# Obrigatório para login/cadastro. Gere com: openssl rand -base64 32
JWT_SECRET=
# Alternativas aceitas pelo servidor: SESSION_SECRET ou AUTH_SECRET

# =============================================================================
# SUPABASE (opcional / legado)
# =============================================================================
# Só necessário se ainda usar OAuth ou ferramentas do conector Supabase.
# O login email/senha NÃO usa mais estas variáveis.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
PORT=3000
BASE_PATH=/

# URL base da API no frontend (vazio = same-origin /api)
# VITE_API_BASE_URL=

# Timeout legado de sessão (ms)
VITE_AUTH_SESSION_TIMEOUT_MS=8000

# =============================================================================
# API KEYS (opcional)
# =============================================================================
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# TAVILY_API_KEY=

KOKORO_ENABLED=true
PLAYWRIGHT_ENABLED=true

# =============================================================================
# NEON DATABASE CONFIGURATION
# =============================================================================
# Obtenha estas variáveis no Neon Dashboard: https://neon.tech
# 1. Crie um novo projeto
# 2. Crie um banco de dados
# 3. Copie a connection string
# 4. Defina DATABASE_URL com a connection string
#
# Formato: postgresql://user:password@host/dbname?sslmode=require
# Exemplo: postgresql://neon_user:neon_password@ep-cool-name-123456.us-east-1.aws.neon.tech/zarith?sslmode=require
# =============================================================================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# =============================================================================
# SUPABASE AUTH CONFIGURATION (Opcional - para autenticação)
# =============================================================================
# Se quiser manter o Supabase Auth, configure estas variáveis
# Caso contrário, comente ou remova
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000
BASE_PATH=/

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# Timeout para obtenção de sessão (ms)
VITE_AUTH_SESSION_TIMEOUT_MS=8000

# =============================================================================
# API KEYS CONFIGURATION
# =============================================================================
# Chaves de API para integrações externas
# GROQ_API_KEY=your-groq-api-key
# GEMINI_API_KEY=your-gemini-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# TAVILY_API_KEY=your-tavily-api-key

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Vercel/Netlify/Cloudflare
# VERCEL_TOKEN=your-vercel-token
# NETLIFY_TOKEN=your-netlify-token
# CLOUDFLARE_TOKEN=your-cloudflare-token

# =============================================================================
# FEATURE FLAGS
# =============================================================================
KOKORO_ENABLED=true
PLAYWRIGHT_ENABLED=true
